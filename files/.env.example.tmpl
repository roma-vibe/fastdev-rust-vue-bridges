# The single configuration of the project, read by every service (crates/core/src/config.rs),
# the web build (web/vite.config.ts) and the scripts. Copy to .env (npm run setup does it).

# Application name and slug. APP_NAME is the single source of the app name (UI, API, page title);
# APP_SLUG is the machine-friendly name{% if features.auth %} (it names the session cookie){% endif %}.
APP_NAME="My App"
APP_SLUG=my-app

# SQLite database shared by the services, relative to the project root.
DB_PATH=data/my-app.sqlite

# 32 random bytes as hex (or base64): encrypts secrets at rest. `npm run setup` generates one.
# Changing it makes stored secrets unreadable. Never commit it.
MASTER_KEY=

# One process or microservices (docs/bridges.md). BRIDGES=on (default): every service runs in one
# process, app-all, and they call each other in memory; BRIDGES=off: each service is its own process
# and they call each other over HTTP. SEPARATE_SERVICES (with BRIDGES=on): comma-separated services
# that keep a process of their own, e.g. `notes`. Restart after a change; no code changes needed.
BRIDGES=on
SEPARATE_SERVICES=
# Tokio worker threads of each process; empty = the CPU cores, at most 4.
WORKER_THREADS=
# A service on another host: <NAME>_URL, e.g. NOTES_URL=http://10.0.0.5:8702 (default: BIND_HOST and
# its port).

# glibc malloc settings, passed to the services by `npm start`, `npm run dev` and set in the Docker
# image; without them memory freed after password hashing is not given back. Empty = the defaults
# MALLOC_ARENA_MAX=2, MALLOC_MMAP_THRESHOLD_=1048576, MALLOC_TRIM_THRESHOLD_=1048576.

# Ports. The edge is the public entry (API + built web app); every service has its own port, open
# only when it runs as a process of its own.
EDGE_PORT=8700
{%- if features.auth %}
IDENTITY_PORT=8701
{%- endif %}
NOTES_PORT=8702
# Vite dev server (npm run dev); proxies /api to the edge.
WEB_PORT=5173

# Interface the services listen on; 0.0.0.0 accepts connections from other hosts.
BIND_HOST=127.0.0.1
# URL users open in the browser{% if features.auth %} (secure cookies when https){% endif %}. Default: the dev server, else the edge.
PUBLIC_URL=
# Built web app served by the edge.
WEB_DIST=web/dist

# error | warn | info | debug | trace, or a RUST_LOG filter like `info,app_notes=debug`.
LOG_LEVEL=info
{%- if choices.docker == "run" %}

# Docker Compose project name (names the container, image and volume).
COMPOSE_PROJECT_NAME=my-app
# Where the container keeps the database: `data` (a Docker volume) or `./data` (this folder).
DOCKER_DATA=data
{%- endif %}
